DirectoryIndex index.php
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://moje-renta.jirijanousek.cz%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^auth(?:/|$) - [F,L]
RewriteRule ^index\.html$ index.php [L]
</IfModule>
<FilesMatch "(?i)^(?:\.env(?:\..*)?|.*\.(?:sqlite|sqlite3|db|bak|log|sql|env)|app\.view\.php|README-auth\.md)$">
Require all denied
</FilesMatch>
